{
  "name": "phaser3-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starter template for browser games on Phaser 3 and TypeScript",
  "license": "MIT",
  "author": "Monax",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "phaser": "^3.90.0",
    "stats-js": "^1.0.1",
    "ua-parser-js": "^1.0.35"
  },
  "devDependencies": {
    "@types/dat.gui": "^0.7.10",
    "@types/stats": "^0.16.30",
    "@types/ua-parser-js": "^0.7.36",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
